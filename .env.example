# Resend — formulario de contacto de /about (solo servidor, sin prefijo NEXT_PUBLIC_)

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Destinatario de los mensajes. Con el remitente onboarding@resend.dev,
# Resend solo entrega al correo dueño de la cuenta de Resend.
CONTACT_TO_EMAIL=correo-del-dueño-de-la-cuenta@dominio.com

# Remitente. Valor de desarrollo: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev
